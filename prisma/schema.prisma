generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma-postgresql"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  CREATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum CreatorReviewStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

enum AssetCategory {
  SKIN
  SHAWL
  COAT
  CAPE
  HAT
  PANTS
  SHOES
  OTHER_ACCESSORY
}
enum AssetKind {
  SKIN_TEXTURE
  CLOTHING_TEXTURE
  ACCESSORY_TEXTURE
  PROJECT_FILE
  PREVIEW_IMAGE
}
enum AssetSource {
  UPLOAD
  AI_GENERATION
  PIXEL_EDITOR
  IMPORT
  COMMUNITY
}
enum AssetVisibility {
  PRIVATE
  UNLISTED
  PUBLIC
}
enum AssetProvenance {
  USER_CREATED
  OFFICIAL
  LICENSED
  THIRD_PARTY
  UNKNOWN
}
enum AssetDownloadPolicy {
  DENY
  OWNER_ONLY
  LICENSED_PUBLIC
}
enum SkinModel {
  CLASSIC
  SLIM
}

model User {
  id            String          @id @default(cuid())
  username      String?         @unique
  name          String?
  email         String?         @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  role          UserRole        @default(USER)
  status        UserStatus      @default(ACTIVE)
  creator       CreatorProfile?
  projects      Project[]
  assets        Asset[] @relation("AssetOwner")
  outfits       Outfit[]
  favorites     AssetFavorite[]
  publications  Publication[]
  workspaceState WorkspaceState?
  editorDocuments EditorDocument[]
  auditAsActor  AuditLog[]       @relation("AuditActor")
  accounts      Account[]
  sessions      Session[]
  slugHistory   UserSlugHistory[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model UserSlugHistory {
  id        String   @id @default(cuid())
  userId    String
  username  String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
}

model CreatorProfile {
  id           String              @id @default(cuid())
  userId       String              @unique
  displayName  String
  bio          String              @default("")
  reviewStatus CreatorReviewStatus @default(NOT_SUBMITTED)
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model Project {
  id          String   @id @default(cuid())
  ownerId     String
  title       String
  description String   @default("")
  visibility  String   @default("PRIVATE")
  assetKey    String?
  document    String   @default("{}") @db.Text
  revision    Int      @default(1)
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  assets      Asset[]
  workspaces  WorkspaceState[]
  @@index([ownerId, updatedAt])
}


model Asset {
  id          String          @id @default(cuid())
  ownerId     String?
  projectId   String?
  kind        AssetKind
  category    AssetCategory?
  storageKey  String          @unique
  mimeType    String
  byteSize    Int
  width       Int?
  height      Int?
  sha256      String?
  source      AssetSource
  visibility  AssetVisibility @default(PRIVATE)
  licenseId   String?
  name        String?
  attribution String?
  provenance  AssetProvenance     @default(UNKNOWN)
  downloadPolicy AssetDownloadPolicy @default(DENY)
  owner       User?           @relation("AssetOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  project     Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  skinOutfits Outfit[]        @relation("OutfitSkin")
  outfitItems OutfitItem[]
  favorites   AssetFavorite[]
  publications Publication[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  @@index([ownerId, category, updatedAt])
  @@index([projectId, updatedAt])
  @@index([visibility, category, createdAt])
  @@index([sha256])
}

model Outfit {
  id          String       @id @default(cuid())
  ownerId     String
  name        String
  skinAssetId String?
  skinModel   SkinModel    @default(CLASSIC)
  background  String?
  pose        String?
  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  skinAsset   Asset?       @relation("OutfitSkin", fields: [skinAssetId], references: [id], onDelete: SetNull)
  items       OutfitItem[]
  publications Publication[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  @@index([ownerId, updatedAt])
  @@index([skinAssetId])
}

model OutfitItem {
  id        String   @id @default(cuid())
  outfitId  String
  assetId   String
  category  AssetCategory
  sortOrder Int      @default(0)
  equipped  Boolean  @default(true)
  outfit    Outfit   @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([outfitId, assetId])
  @@index([assetId])
  @@index([outfitId, sortOrder])
}

model AssetFavorite {
  id        String   @id @default(cuid())
  userId    String
  assetId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([userId, assetId])
  @@index([userId, createdAt])
  @@index([assetId])
}

model Publication {
  id          String   @id @default(cuid())
  ownerId     String
  assetId     String?
  outfitId    String?
  title       String
  description String   @default("")
  status      String   @default("DRAFT")
  publishedAt DateTime?
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  asset       Asset?   @relation(fields: [assetId], references: [id], onDelete: SetNull)
  outfit      Outfit?  @relation(fields: [outfitId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([ownerId, updatedAt])
  @@index([status, publishedAt])
  @@index([assetId])
  @@index([outfitId])
}

model WorkspaceState {
  id             String   @id @default(cuid())
  userId         String   @unique
  projectId      String?
  activeTool     String   @default("WARDROBE")
  activeAssetId  String?
  activeOutfitId String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project        Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@index([projectId])
}

model EditorDocument {
  id        String   @id @default(cuid())
  ownerId   String
  name      String   @default("未命名作品")
  document  String   @db.Text
  revision  Int      @default(1)
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([ownerId, updatedAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  targetType String
  targetId   String
  details    Json?
  actor      User     @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now())
  @@index([targetType, targetId, createdAt])
}

model LoginRateLimit {
  key             String   @id
  windowStartedAt DateTime
  count           Int      @default(0)
  updatedAt       DateTime @updatedAt
  @@index([windowStartedAt])
}

// Auth.js Prisma Adapter models
model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
