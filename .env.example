# Copy to .env.local for local development. Never commit real secrets.
PIXSCAPE_IMAGE_TAG="latest"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/pixcape?schema=public"
# PostgreSQL is the only supported database.

# Optional URL for a separately hosted editor integration. Canonical CDPC pages and Studio are served by Next.js.
NEXT_PUBLIC_EDITOR_URL=""

# Auth.js / NextAuth v4
# Configure a private admin path (8-64 letters, numbers, _ or -); /admin is always blocked publicly.
CDPC_ADMIN_PATH="/control-room"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
# Production canonical URL for CDPC on Zeabur: https://cdpc.cc
# Override to http://localhost:3000 only for local development.
NEXTAUTH_URL="http://localhost:3000"

# Optional OAuth providers: configure only the providers you intend to enable.
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
# Tenant can be common, organizations, consumers, or a tenant UUID.
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID="common"
AUTH_APPLE_ID=""
AUTH_APPLE_SECRET=""

# Administrator credentials (all three are required to enable the separate admin login form). Use a long unique password.
ADMIN_USERNAME=""
ADMIN_PASSWORD=""
ADMIN_EMAIL=""

# Optional email magic-link sign-in. Configure a valid SMTP connection URL and sender.
EMAIL_SERVER=""
EMAIL_FROM="Pixcape <no-reply@example.com>"
# false (default) means no separate email-verification gate; true requires email verification to be implemented/configured before account activation.
EMAIL_VERIFICATION_REQUIRED="false"

# Persistent database-backed auth throttling defaults: 10 attempts per IP per 15 minutes.
LOGIN_RATE_LIMIT_MAX="10"
LOGIN_RATE_LIMIT_WINDOW_SECONDS="900"
# Default assumes a trusted reverse proxy overwrites x-real-ip. Do not trust client-supplied headers at a directly exposed origin.
LOGIN_RATE_LIMIT_IP_HEADER="x-real-ip"

# Initial administrator bootstrap: first sign in with a configured provider, then run
# npm run db:bootstrap-admin with this email set. Remove it after the one-time operation.
BOOTSTRAP_ADMIN_EMAIL=""

# Shared high-entropy service token for syncing encrypted AI provider settings to ai-api.
# Generate with: openssl rand -hex 32
# Set the exact same value in the web service and ai-api service; never expose it to the browser.
AI_CONFIG_SYNC_TOKEN=
# AI_CONFIG_URL is fixed by default in the independent AI service to https://cdpc.cc/api/internal/ai-config.
