# Set these in the deployment platform's secret/environment settings.
# Never add real API keys to Git or VITE_* frontend variables.
GEMINI_API_KEY=
GEMINI_IMAGE_MODELS=gemini-2.5-flash-image
# Legacy single-model alias: GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
OPENAI_API_KEY=
OPENAI_IMAGE_MODELS=gpt-image-1,gpt-image-1.5
# Legacy single-model alias: OPENAI_IMAGE_MODEL=gpt-image-1
OPENROUTER_API_KEY=
OPENROUTER_IMAGE_MODELS=
# Optional allow-list of OpenRouter models verified to accept reference images:
OPENROUTER_IMAGE_TO_IMAGE_MODELS=
# Legacy single-model aliases: OPENROUTER_IMAGE_MODEL= ; OPENROUTER_IMAGE_TO_IMAGE_MODEL=
# Doubao Seedream via Volcengine Ark. Keep this key server-side.
ARK_API_KEY=
SEEDREAM_IMAGE_MODELS=doubao-seedream-5-0-lite-260128
# Optional aliases: VOLCENGINE_ARK_API_KEY= ; SEEDREAM_IMAGE_MODEL=doubao-seedream-5-0-lite-260128
# Optional custom Ark endpoint and output size (e.g. 2K).
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SEEDREAM_IMAGE_SIZE=2K
AI_DEFAULT_PROVIDER=auto
AI_DEFAULT_MODEL=
AI_MAX_UPLOAD_MB=8
AI_RATE_LIMIT_PER_MINUTE=5
AI_TIMEOUT_MS=90000
# Comma-separated exact frontend origins; leave empty only for local development.
AI_ALLOWED_ORIGINS=http://localhost:5173
PORT=8787

# Optional: sync provider keys and model selection from the CDPC admin console.
# Configure the same random token in the CDPC web service and this AI service.
AI_CONFIG_URL=https://cdpc.cc/api/internal/ai-config
AI_CONFIG_SYNC_TOKEN=
