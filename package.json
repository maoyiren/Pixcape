{
  "name": "pixcape",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run build:blockbench && npm run build:app",
    "build:app": "tsc -b && vite build",
    "build:blockbench": "node scripts/build-blockbench.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "next:dev": "next dev --hostname 0.0.0.0",
    "next:build": "npm run db:generate:all && next build",
    "next:start": "next start --hostname 0.0.0.0",
    "db:generate": "npm run db:generate:all",
    "db:migrate": "prisma migrate deploy",
    "db:bootstrap-admin": "node scripts/bootstrap-admin.mjs",
    "test:unit": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "test:integration": "node --experimental-strip-types --test tests/integration/security.integration.test.mjs",
    "test:e2e": "node --experimental-strip-types --test tests/e2e/*.test.mjs",
    "test": "npm run test:unit && npm run test:integration",
    "test:mysql-rate-limit": "node --experimental-strip-types --test tests/integration/mysql-rate-limit.test.mjs",
    "test:sqlite-rate-limit": "node --experimental-strip-types --test tests/integration/sqlite-rate-limit.test.mjs",
    "db:generate:all": "prisma generate --schema prisma/schema.prisma && prisma generate --schema prisma/schema.mysql.prisma && prisma generate --schema prisma/schema.sqlite.prisma"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.2.16",
    "lucide-react": "^1.57.0",
    "next": "^16.4.0",
    "next-auth": "^4.24.15",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "skinview3d": "^3.4.2",
    "three": "^0.186.0",
    "@prisma/adapter-mariadb": "^7.10.0",
    "mariadb": "^3.4.5",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "better-sqlite3": "^13.0.3",
    "nodemailer": "^10.0.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-react": "^6.1.2",
    "prisma": "^7.10.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "mysql2": "^3.23.1",
    "nodemailer": "^10.0.6"
  }
}
