{
  "name": "pixcape",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "npm run next:build",
    "build:blockbench": "node scripts/build-blockbench.mjs",
    "preview": "next start --hostname 0.0.0.0",
    "next:dev": "next dev --hostname 0.0.0.0",
    "next:build": "npm run db:generate && next build",
    "next:start": "next start --hostname 0.0.0.0",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:bootstrap-admin": "node scripts/bootstrap-admin.mjs",
    "test:unit": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "test:integration": "node --experimental-strip-types --test tests/integration/*.integration.test.mjs",
    "test:e2e": "node --experimental-strip-types --test tests/e2e/*.test.mjs",
    "test": "npm run test:unit && npm run test:integration",
    "db:push": "node scripts/db-push.mjs",
    "test:browser": "playwright test",
    "start": "next start --hostname 0.0.0.0"
  },
  "dependencies": {
    "@mantine/core": "^9.7.5",
    "@mantine/hooks": "^9.7.5",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.2.16",
    "lucide-react": "^1.67.0",
    "next": "^16.4.5",
    "next-auth": "^4.24.15",
    "nodemailer": "^10.0.6",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "skinview3d": "^3.4.2",
    "three": "^0.186.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "nodemailer": "^10.0.6"
  },
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=26.13.0",
    "npm": ">=11.19.1"
  }
}
